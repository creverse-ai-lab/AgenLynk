{
  "name": "agenlynk",
  "version": "0.4.1",
  "description": "Open-source macOS app that ties local AI agents together and monitors delegated work.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "files": [
    "sidecar/",
    "gateway.lock.json",
    "scripts/fetch-gateway-runtime.js",
    "README.md"
  ],
  "bin": {
    "agenlynk-sidecar": "sidecar/src/server/monitor.js"
  },
  "scripts": {
    "monitor:server": "node sidecar/src/server/monitor.js",
    "sidecar:test": "node --test sidecar/test/*.test.js",
    "macos:build": "sh macos/scripts/build-app.sh",
    "macos:dmg": "sh macos/scripts/build-dmg.sh",
    "macos:verify": "sh macos/scripts/verify-dmg.sh",
    "macos:test": "sh macos/scripts/test-models.sh",
    "macos:clean": "sh macos/scripts/clean-derived.sh",
    "macos:run": "open \"build/AgenLynk.app\"",
    "test": "node scripts/run-tests.js",
    "test:quick": "node scripts/run-tests.js --quick",
    "gateway:fetch": "node scripts/fetch-gateway-runtime.js --output build/cache/gateway-runtime",
    "package:smoke": "node scripts/package-smoke.js",
    "ci": "node scripts/ci-check.js && npm test"
  },
  "engines": {
    "node": ">=22"
  }
}
